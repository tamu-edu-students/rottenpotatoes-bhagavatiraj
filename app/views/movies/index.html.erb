
<p style="color: green"><%= notice %></p>

<% content_for :title, "Movies" %>

<h1>RottenPotatoes Movies</h1>

<table>
  <thead>
    <tr>
      <th class="<%= 'sorted' if params[:sort] == 'title' || params[:sort].blank? %>">
  <%= link_to "Title", movies_path(sort: "title", direction: params[:sort] == "title" && params[:direction] == "asc" ? "desc" : "asc") %>
  <%= params[:sort] == "title" || params[:sort].blank? ? (params[:direction] == "desc" ? "▼" : "▲") : "" %>
</th>

<th class="<%= 'sorted' if params[:sort] == 'rating' %>">
  <%= link_to "Rating", movies_path(sort: "rating", direction: params[:sort] == "rating" && params[:direction] == "asc" ? "desc" : "asc") %>
  <%= params[:sort] == "rating" ? (params[:direction] == "desc" ? "▼" : "▲") : "" %>
</th>

<th class="<%= 'sorted' if params[:sort] == "release_date" %>">
  <%= link_to "Release Date", movies_path(sort: "release_date", direction: params[:sort] == "release_date" && params[:direction] == "asc" ? "desc" : "asc") %>
  <%= params[:sort] == "release_date" ? (params[:direction] == "desc" ? "▼" : "▲") : "" %>
</th>
      <th>Actions</th>
    </tr>
  </thead>

  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><%= link_to movie.title, movie %></td>
        <td><%= movie.rating %></td>
        <td><%= movie.release_date&.strftime("%d %b %Y") %></td>
        
        <td class="actions">
          <%= link_to "Edit", edit_movie_path(movie) %>
          <%= button_to "Delete", movie, method: :delete,
                form: { data: { turbo_confirm: "Are you sure?" } } %>
        </td>

      </tr>
    <% end %>
  </tbody>
  

  <tfoot>
    <tr>
      <td colspan="4">Total movies: <%= @movies.size %></td>
    </tr>
  </tfoot>
</table>

<p><%= link_to "Add New Movie", new_movie_path %></p>
