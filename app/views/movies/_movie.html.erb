
<div id="<%= dom_id movie %>" class="movie-details">
  <div class="detail-row">
    <strong>Title</strong>
    <span><%= movie.title %></span>
  </div>

  <div class="detail-row">
    <strong>Rating</strong>
    <span><%= movie.rating %></span>
  </div>

  <div class="detail-row">
    <strong>Description</strong>
    <span><%= movie.description.presence || "No description available." %></span>
  </div>

  <div class="detail-row">
    <strong>Release date</strong>
    <span><%= movie.release_date&.strftime("%d %b %Y") || "Not specified" %></span>
  </div>
</div>
