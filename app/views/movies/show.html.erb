
<% content_for :title, @movie.title %>

<% if notice.present? %>
  <p class="notice"><%= notice %></p>
<% end %>

<h1>Movie Details</h1>

<%= render @movie %>

<div class="button-row">
  <%= link_to "Edit Movie", edit_movie_path(@movie), class: "button button-primary" %>
  <%= link_to "Back to Movies", movies_path, class: "button button-secondary" %>

  <%= button_to "Delete Movie", @movie,
        method: :delete,
        class: "button button-danger",
        form: { class: "inline-form", data: { turbo_confirm: "Are you sure you want to delete this movie?" } } %>
</div>
