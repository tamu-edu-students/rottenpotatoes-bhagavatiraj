
<%= form_with(model: movie, html: { class: "movie-form" }) do |form| %>
  <% if movie.errors.any? %>
    <div class="form-errors">
      <h2><%= pluralize(movie.errors.count, "error") %> prevented this movie from being saved:</h2>

      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-field">
    <%= form.label :title %>
    <%= form.text_field :title, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :rating %>
    <%= form.text_field :rating, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4, class: "form-input" %>
  </div>

  <div class="form-field">
    <%= form.label :release_date %>
    <%= form.date_field :release_date, class: "form-input" %>
  </div>

  <div class="button-row">
    <%= form.submit class: "button button-primary" %>
    <%= link_to "Cancel", movies_path, class: "button button-secondary" %>
  </div>
<% end %>
